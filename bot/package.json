{
  "name": "@angelo/tote-bot",
  "version": "1.0.0",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "simulate": "node --experimental-strip-types scripts/simulate.ts",
    "db:migrate:local": "wrangler d1 migrations apply tote-bot --local",
    "db:migrate:remote": "wrangler d1 migrations apply tote-bot --remote"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  },
  "private": true
}
